{
  "name": "perkim-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistem pemantauan laman web PERKIM Kuala Langat",
  "scripts": {
    "audit": "node tools/audit.mjs --site ../perkim-web",
    "audit:full": "node tools/audit.mjs --site ../perkim-web --lighthouse",
    "serve": "node tools/serve.mjs 8082",
    "start": "node tools/audit.mjs --site ../perkim-web --lighthouse && node tools/serve.mjs 8082"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.2.1"
  }
}
